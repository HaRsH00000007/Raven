# Copy to backend/.env for local (non-docker) runs.
DATABASE_URL=postgresql+asyncpg://raven:raven@localhost:5432/raven
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

ADMIN_TOKEN=change-me-admin
DEV_BOOTSTRAP_API_KEY=rvn_dev_local_key_change_me
DEV_BOOTSTRAP_CREDITS=5000

# Replies: point MX for this domain at Postmark/SendGrid inbound, then set the webhook to
#   {PUBLIC_BASE_URL}/api/v1/webhooks/inbound/postmark?token=INBOUND_WEBHOOK_TOKEN
REPLY_DOMAIN=replies.example.com
INBOUND_WEBHOOK_TOKEN=change-me-webhook
PUBLIC_BASE_URL=http://localhost:8000
TWILIO_AUTH_TOKEN=

# Forwarding positive replies
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Raven <notifications@example.com>

# Optional: Claude for reply triage + form-field fallback (rules are used without it)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Form engine
SCREENSHOT_DIR=./data/screenshots
WORKER_CONCURRENCY=8
COOLDOWN_DAYS=90
BILL_UNVERIFIED=false
BOT_USER_AGENT_TOKEN=RavenFormBot/1.0
BOT_INFO_URL=https://example.com/bot
