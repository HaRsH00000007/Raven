# Read by docker-compose.yml. Copy to .env and edit.
RAVEN_API_KEY=rvn_dev_local_key_change_me
ADMIN_TOKEN=change-me-admin
DEV_BOOTSTRAP_CREDITS=5000
ENVIRONMENT=development

REPLY_DOMAIN=replies.example.com
INBOUND_WEBHOOK_TOKEN=change-me-webhook
PUBLIC_BASE_URL=http://localhost:8000
TWILIO_AUTH_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Raven <notifications@example.com>

# Optional. Without it, replies are sorted by built-in rules.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Credits: grants expire this many days after issue (1 billing month + 1 rollover month)
CREDIT_VALIDITY_DAYS=60

# Optional voicemail transcription (first set wins). Without either, the simulator/Twilio transcript is used.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=

# The /simulate/inbound endpoint is always on outside production; set true to allow it in production.
ALLOW_SIMULATOR=false

WORKER_CONCURRENCY=4
BILL_UNVERIFIED=false
BOT_INFO_URL=https://example.com/bot

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
